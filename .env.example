# Cloudflare R2 — cloud video/thumbnail storage (free 10GB, no card needed)
# Replace with your R2 bucket details; see deploy/koyeb-baadar.md
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=baadar-videos
# R2_PUBLIC_URL=

# n8n Cloud URL (move n8n off Mac to Koyeb — see deploy/n8n-koyeb.md)
# Points to your n8n instance for workflow triggers from Baadar
# N8N_WEBHOOK_BASE=https://your-n8n-koyeb-app.koyeb.app/webhook/

# ── Stage 2 · Logto auth (JWT/RBAC) — inert until LOGTO_ENDPOINT is set ──
# 1. Create a free tenant at https://logto.io  → add an API resource (SaathiAI)
# 2. Set the two values below to activate bearer-JWT auth in front of /api/*
# LOGTO_ENDPOINT=https://your-tenant.logto.app
# LOGTO_API_RESOURCE=https://api.saathi   # the API resource indicator you defined

# OpenRouter — one key serves GLM / DeepSeek / Qwen via the Model Router
# OPENROUTER_API_KEY=
# DEEPSEEK_MODEL=deepseek/deepseek-chat
# GLM_MODEL=z-ai/glm-4.6
# QWEN_MODEL=qwen/qwen-2.5-72b-instruct

# Human Browser Driver — shared HMAC secret (VM signs jobs, Mac Agent verifies)
# HUMAN_BROWSER_SECRET=

# --- NEPSE live market feed (LICENSED VENDOR ONLY) ---
# Policy NEPSE-DATA-1: SaathiOS never scrapes NEPSE public or protected portals.
# A live feed must be a licensed vendor endpoint you are entitled to use.
# Leave blank to run on the in-repo snapshot (the UI says so explicitly).
NEPSE_FEED_URL=
NEPSE_FEED_ALLOWLIST=
NEPSE_FEED_KEY=
NEPSE_FEED_HEADER=Authorization
# bulk = one call returning many quotes | per-symbol = one call per symbol
NEPSE_FEED_MODE=bulk
