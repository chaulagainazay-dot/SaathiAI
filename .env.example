
# Animated video: ElevenLabs voiceover + HeyGen avatar
# Baadar UI password (shown on login screen before anyone can use the app)
# Cheap proxy — routes Claude requests → Groq (free)
# Copy to .env and fill in
# FREE brain: Google Gemini — get key at https://aistudio.google.com/apikey (no card needed)
# GitHub (for Actions status in Baadar UI)
# Gmail (read/send email) — one-time Google OAuth; generate via email-agent script
# Groq — fastest brain (free): get key at https://console.groq.com/keys
# HCGMS Supabase (same project as the canteen app)
# Mr. Yeti cloned voice (OmniVoice profile)
# Offline fallback — Ollama (auto-used when Groq/Gemini unreachable)
# OmniVoice Studio local server (install the DMG from Downloads, default port may differ)
# OpenAI ChatGPT (primary LLM for Mr. Yeti script generation)
# Telegram (same bot as HCGMS notifications)
# Twitter/X — @pieltsofficial
# n8n (docker run -p 5678:5678 n8nio/n8n) — holds Facebook/LinkedIn/YouTube credentials
ANTHROPIC_API_KEY=
BAADAR_PASSWORD=
CHEAP_PROXY_URL=
CLAUDE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FIREBASE_CREDENTIALS_JSON=
GEMINI_MODEL=
GITHUB_REPO=
GITHUB_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GOOGLE_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_DEFAULT_MODEL=kimi-k2.7-code
HEYGEN_API_KEY=
HEYGEN_TALKING_PHOTO_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_PERSON_URN=
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
N8N_WEBHOOK_BASE=
OLLAMA_MODEL=
SHIMMY_API_KEY=
SHIMMY_MODEL=
SHIMMY_URL=
OMNIVOICE_TTS_URL=
OMNIVOICE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
SAATHI_PORT=
SAATHI_TOKEN=
SPEAKER_THRESHOLD=
SUPABASE_SERVICE_KEY=
SUPABASE_URL=
