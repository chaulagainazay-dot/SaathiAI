# Copy to .env and fill in
# FREE option (recommended): Gemini key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Paid option (better reasoning): Claude — used only if GOOGLE_API_KEY is empty
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# OmniVoice Studio local server (install the DMG from Downloads, default port may differ)
OMNIVOICE_URL=http://127.0.0.1:8920

# HCGMS Supabase (same project as the canteen app)
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# n8n (docker run -p 5678:5678 n8nio/n8n) — holds Facebook/LinkedIn/YouTube credentials
N8N_WEBHOOK_BASE=http://127.0.0.1:5678/webhook

# Telegram (same bot as HCGMS notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SAATHI_PORT=8765
SPEAKER_THRESHOLD=0.75

# 100% LOCAL brain (no internet, fully private): install Ollama, then
#   ollama pull qwen2.5:3b
# and uncomment:
#LLM_PROVIDER=ollama
#OLLAMA_MODEL=qwen2.5:3b
