<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ajay.saathiai</string>

  <!-- Use caffeinate wrapper so Mac never sleeps while Baadar runs -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/macbookpro/SaathiAI/scripts/start_baadar.sh</string>
  </array>

  <key>WorkingDirectory</key><string>/Users/macbookpro/SaathiAI</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Auto-start on login -->
  <key>RunAtLoad</key><true/>

  <!-- Restart automatically if it crashes -->
  <key>KeepAlive</key><true/>

  <!-- Logs -->
  <key>StandardOutPath</key><string>/Users/macbookpro/SaathiAI/data/saathi.log</string>
  <key>StandardErrorPath</key><string>/Users/macbookpro/SaathiAI/data/saathi.err.log</string>
</dict>
</plist>
