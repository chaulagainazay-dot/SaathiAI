[Unit]
Description=SaathiAI Platform API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/SaathiAI
EnvironmentFile=/home/ubuntu/SaathiAI/.env
ExecStart=/home/ubuntu/SaathiAI/.venv/bin/python -m saathi.server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
