# secrets — never commit
.env

# runtime data: voice profile, memory db, logs, uploaded files
data/
# Authoritative AgentDev role registry is package data, not runtime state.
# Without these exceptions a broad `data/` rule hides roles.json from git and
# clean CI checkouts raise registry_not_found for the entire agentdev suite.
!saathi/agentdev/data/
!saathi/agentdev/data/roles.json

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
# uv lockfiles are local/tooling artifacts unless an approved milestone
# intentionally adopts uv-managed dependency locking for the monorepo.
uv.lock
uv.lock.bak
firebase-admin.json
.superpowers/

# Credentials and large binaries — never commit
.proxy.env
scripts/pielts-sa-key.json
anthropic-proxy
videos_output/
reels_output/
thumbnails/
research_cache/
run_human_agent.sh
queue/

# Run Manager workspaces (reproducible artifacts, not source)
runs/

# bring-your-own music (no copyrighted audio in git)
assets/music/*
!assets/music/README.md
assets/logo.png

# credentials / env backups — never commit
secrets/
.env.bak

# pattern-based secret exclusions — never commit (Repair 0)
.env.*
!.env.example
*-admin.json
!*-admin.example.json
*serviceAccount*.json
*service-account*.json
*.pem
*.key
*.p12
*.pfx
*-credentials.json
*_credentials.json
*.token
token.json
oauth*.json
*session*.json
!*.example.json

# Local AI-agent runtime state
.saathi-agent-state/

# Local runtime databases
storage/*.db
storage/*.db-shm
storage/*.db-wal

# M43 operator-local canary approval record — operator-specific, never commit
docs/m41/operator_canary_approval.local.json
docs/m41/*.local.json

# M46 operator-local approval / live records — never commit
docs/m46/*.local.json
docs/m46/operator_canary_approval.local.json
docs/evidence/m46/*.local.jsonl
docs/evidence/m46/consumed_authorization.local.jsonl
docs/evidence/m46/*.local.jsonl.lock
docs/m46/*.local.json.save
docs/m46/*.save
docs/ui-ux/m47_4_evidence/screenshots/
docs/ui-ux/m47_7_evidence/screenshots/
docs/platform/m54_evidence/screenshots/
docs/platform/m55_evidence/screenshots/
docs/platform/m56_evidence/screenshots/
docs/platform/m57_evidence/screenshots/
.saathi-local/

# M264-M271 frozen historical snapshots (local only)
data/platform/historical_snapshots/

# ECC engineering harness (development plane only, never authoritative).
# Runtime state, and vendor components synced from the pinned ecc@ecc plugin cache.
# Reproduce with: scripts/ecc_profile_sync.sh   (manifest: .claude/ecc-profile.json)
.ecc-data/
.claude/skills/
.claude/agents/
.claude/commands/
.claude/rules/ecc/
# Runtime state. Written continuously by ordinary operation; never evidence.
# See saathi/runtime_paths.py — docs/evidence/** stays the committed record.
.runtime/
