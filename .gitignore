# secrets — never commit
.env

# runtime data: voice profile, memory db, logs, uploaded files
data/

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
firebase-admin.json
.superpowers/

# Credentials and large binaries — never commit
.proxy.env
scripts/pielts-sa-key.json
anthropic-proxy
videos_output/
reels_output/
thumbnails/
research_cache/
run_human_agent.sh
queue/

# Run Manager workspaces (reproducible artifacts, not source)
runs/

# bring-your-own music (no copyrighted audio in git)
assets/music/*
!assets/music/README.md
assets/logo.png

# credentials / env backups — never commit
secrets/
.env.bak

# pattern-based secret exclusions — never commit (Repair 0)
.env.*
!.env.example
*-admin.json
!*-admin.example.json
*serviceAccount*.json
*service-account*.json
*.pem
*.key
*.p12
*.pfx
*-credentials.json
*_credentials.json
*.token
token.json
oauth*.json
*session*.json
!*.example.json

# Local AI-agent runtime state
.saathi-agent-state/

# Local runtime databases
storage/*.db
storage/*.db-shm
storage/*.db-wal

# M43 operator-local canary approval record — operator-specific, never commit
docs/m41/operator_canary_approval.local.json
docs/m41/*.local.json

# M46 operator-local approval / live records — never commit
docs/m46/*.local.json
docs/m46/operator_canary_approval.local.json
